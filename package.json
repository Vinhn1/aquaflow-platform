{
  "name": "aquaflow-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AquaFlow - Digital Water Customer Service Platform (Target Prototype: CAWACO)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mini-app": "npm --prefix apps/mini-app run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build:mini-app": "npm --prefix apps/mini-app run build",
    "build:api": "npm --prefix apps/api run build",
    "test:api": "npm --prefix apps/api test"
  },
  "keywords": [
    "water-utility",
    "customer-service",
    "cawaco",
    "zalo-mini-app",
    "aquaflow"
  ],
  "author": "AquaFlow Team",
  "license": "UNLICENSED"
}
