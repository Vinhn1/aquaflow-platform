# Multi-stage Dockerfile for AquaFlow Backend API
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache openssl

# Copy root and package descriptors
COPY package*.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Install dependencies
RUN npm ci

# Generate Prisma Client & Build API project
RUN npm --prefix apps/api run db:generate
RUN npm --prefix apps/api run build

# Production Runner
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

RUN apk add --no-cache openssl

# Security: Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --chown=appuser:appgroup --from=builder /app/package*.json ./
COPY --chown=appuser:appgroup --from=builder /app/node_modules ./node_modules
COPY --chown=appuser:appgroup --from=builder /app/packages ./packages
COPY --chown=appuser:appgroup --from=builder /app/apps/api/src ./apps/api/src
COPY --chown=appuser:appgroup --from=builder /app/apps/api/dist ./apps/api/dist
COPY --chown=appuser:appgroup --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --chown=appuser:appgroup --from=builder /app/apps/api/prisma ./apps/api/prisma

USER appuser

EXPOSE 3000

CMD ["npx", "tsx", "apps/api/src/server.ts"]
