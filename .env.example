# Server Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquaflow_dev?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_development_only_change_in_production
JWT_EXPIRES_IN=7d

# Integration Mock Flags (Set true to use Mock Adapters when real external APIs are unavailable)
MOCK_CAWACO_API=true
MOCK_PAYMENT_GATEWAY=true
MOCK_ZALO_AUTH=true

# Zalo Platform Integration (When MOCK_ZALO_AUTH=false)
ZALO_APP_ID=your_zalo_app_id_here
ZALO_APP_SECRET=your_zalo_app_secret_here

# Payment Gateway Configuration (When MOCK_PAYMENT_GATEWAY=false)
VIETQR_CLIENT_ID=your_vietqr_client_id
VIETQR_API_KEY=your_vietqr_api_key
