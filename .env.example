# Server Environment
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database Configuration (Docker / Local PostgreSQL)
DATABASE_URL="postgresql://aquaflow_user:change_this_password@localhost:5432/aquaflow_cawaco?schema=public"

# Authentication & Security
JWT_SECRET=generate_a_secure_random_string_at_least_32_chars_in_production
JWT_EXPIRES_IN=7d
PAYMENT_WEBHOOK_SECRET=generate_a_secure_webhook_hmac_secret_in_production

# Integration Mock Flags (Set false to use Real Database & Adapters)
MOCK_CAWACO_API=false
MOCK_PAYMENT_GATEWAY=false
MOCK_ZALO_AUTH=false

# Zalo Platform Integration (CAWACO Mini App ID: 2784671839475576206 | App ID: 3879828502555234376 | OA ID: 2562028218754028209)
ZALO_APP_ID=3879828502555234376
ZALO_MINI_APP_ID=2784671839475576206
ZALO_OA_ID=2562028218754028209
ZALO_APP_SECRET=your_zalo_app_secret_here

# Payment Gateway Configuration (VietQR NAPAS247)
VIETQR_CLIENT_ID=your_vietqr_client_id
VIETQR_API_KEY=your_vietqr_api_key
