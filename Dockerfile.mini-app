# Multi-stage Dockerfile for AquaFlow Zalo Mini App Frontend
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY apps/mini-app/ ./apps/mini-app/

RUN npm ci
RUN npm --prefix apps/mini-app run build

# Nginx Static Server
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/mini-app/www /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
